<%- include("../layouts/header") %>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <h2 class="fw-bold">
                Admin Dashboard
            </h2>

            <p class="text-muted">
                Welcome, <%= admin.name %>
            </p>
        </div>

        <a href="/admin/logout"
           class="btn btn-danger rounded-pill px-4">

            Logout

        </a>

    </div>

    <!-- Statistics -->

    <div class="row g-4">

        <div class="col-lg-4 col-md-6">

            <div class="admin-card p-4">

                <div class="d-flex justify-content-between">

                    <div>

                        <h6 class="text-muted">
                            Total News
                        </h6>

                        <h2>
                            <%= dashboardData.totalNews %>
                        </h2>

                    </div>

                    <div class="display-5">
                        📰
                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4 col-md-6">

            <div class="admin-card p-4">

                <div class="d-flex justify-content-between">

                    <div>

                        <h6 class="text-muted">
                            Categories
                        </h6>

                        <h2>
                            <%= dashboardData.totalCategories %>
                        </h2>

                    </div>

                    <div class="display-5">
                        📂
                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4 col-md-6">

            <div class="admin-card p-4">

                <div class="d-flex justify-content-between">

                    <div>

                        <h6 class="text-muted">
                            Breaking News
                        </h6>

                        <h2>
                            <%= dashboardData.breakingNews %>
                        </h2>

                    </div>

                    <div class="display-5">
                        🔥
                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4 col-md-6">

    <div class="admin-card p-4">

        <div class="d-flex justify-content-between">

            <div>

                <h6 class="text-muted">
                    Total Videos
                </h6>

                <h2>
                    <%= dashboardData.totalVideos %>
                </h2>

            </div>

            <div class="display-5">
                🎥
            </div>

        </div>

    </div>

</div>

    </div>

    <hr class="my-5">

    <!-- Quick Actions -->
<!-- Quick Actions -->

<h4 class="mb-4">
    Quick Actions
</h4>

<div class="row g-4">

    <div class="col-md-3">

        <a href="/admin/news"
           class="btn btn-primary w-100 py-3">

            📰 Manage News

        </a>

    </div>


    <div class="col-md-3">

        <a href="/admin/news/add"
           class="btn btn-success w-100 py-3">

            ➕ Add News

        </a>

    </div>


    <div class="col-md-3">

        <a href="/admin/categories"
           class="btn btn-warning w-100 py-3">

            📂 Categories

        </a>

    </div>


    <div class="col-md-3">

        <a href="/admin/messages"
           class="btn btn-info w-100 py-3">

            📧 Messages

        </a>

    </div>


    <div class="col-md-3">

        <a href="/admin/videos"
           class="btn btn-danger w-100 py-3">

            🎥 Manage Videos

        </a>

    </div>


    <div class="col-md-3">

        <a href="/admin/videos/add"
           class="btn btn-dark w-100 py-3">

            ➕ Add Video

        </a>

    </div>

</div>

</div>

<%- include("../layouts/footer") %>