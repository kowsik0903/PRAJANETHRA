<!-- ============================= -->
<!-- VIDEO NEWS SECTION -->
<!-- ============================= -->

<section class="video-news-section py-5">

    <div class="container">

        <!-- SECTION HEADER -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold mb-1">
                    🎥 Video News
                </h2>

                <p class="text-muted mb-0">
                    Latest news videos from PRAJANETHRA
                </p>

            </div>


            <a
                href="/videos"
                class="btn btn-outline-danger">

                View All Videos

            </a>

        </div>


        <!-- VIDEOS -->

        <% if (videos && videos.length > 0) { %>

            <div class="row g-4">

                <% videos.forEach(video => { %>

                    <div class="col-lg-4 col-md-6">

                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">


                            <!-- VIDEO -->

                            <div class="ratio ratio-16x9">

                                <% if (
                                    video.video_type === "upload" &&
                                    video.video_url
                                ) { %>

                                    <video
                                        controls
                                        preload="metadata"
                                        playsinline
                                        style="
                                            width:100%;
                                            height:100%;
                                            object-fit:cover;
                                        ">

                                        <source
                                            src="<%= video.video_url %>"
                                            type="video/mp4">

                                        Your browser does not support
                                        the video player.

                                    </video>


                                <% } else if (video.youtube_url) { %>

                                    <%
                                        let videoId = "";
                                        const youtubeUrl =
                                            video.youtube_url || "";

                                        if (
                                            youtubeUrl.includes("watch?v=")
                                        ) {

                                            videoId =
                                                youtubeUrl
                                                .split("watch?v=")[1]
                                                .split("&")[0];

                                        } else if (
                                            youtubeUrl.includes("youtu.be/")
                                        ) {

                                            videoId =
                                                youtubeUrl
                                                .split("youtu.be/")[1]
                                                .split("?")[0];

                                        } else if (
                                            youtubeUrl.includes("/embed/")
                                        ) {

                                            videoId =
                                                youtubeUrl
                                                .split("/embed/")[1]
                                                .split("?")[0];

                                        }
                                    %>


                                    <% if (videoId) { %>

                                        <iframe
                                            src="https://www.youtube.com/embed/<%= videoId %>"
                                            title="<%= video.title %>"
                                            frameborder="0"
                                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                            allowfullscreen>
                                        </iframe>

                                    <% } else { %>

                                        <div class="video-unavailable">

                                            Video unavailable

                                        </div>

                                    <% } %>


                                <% } else { %>

                                    <div class="video-unavailable">

                                        Video unavailable

                                    </div>

                                <% } %>

                            </div>


                            <!-- CARD CONTENT -->

                            <div class="card-body p-3">


                                <!-- CATEGORY -->

                                <% if (video.category_name) { %>

                                    <span class="badge bg-danger mb-2">

                                        🎥
                                        <%= video.category_name %>

                                    </span>

                                <% } %>


                                <!-- TITLE -->

                                <h5 class="fw-bold mb-2">

                                    <%= video.title %>

                                </h5>


                                <!-- SHORT DESCRIPTION -->

                                <% if (video.short_description) { %>

                                    <p class="text-muted mb-3">

                                        <%= video.short_description %>

                                    </p>

                                <% } %>


                                <!-- DATE -->

                                <small class="text-muted d-block mb-3">

                                    <%= new Date(
                                        video.created_at
                                    ).toLocaleDateString() %>

                                </small>


                                <!-- WATCH & READ -->

                                <a
                                    href="/videos/<%= video.id %>"
                                    class="btn btn-danger btn-sm">

                                    🎥 Watch & Read

                                </a>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>


        <% } else { %>

            <div class="text-center py-5">

                <h5 class="text-muted">

                    No videos available.

                </h5>

            </div>

        <% } %>

    </div>

</section>


<style>

.video-news-section {

    width: 100%;

}


.video-news-section .ratio {

    overflow: hidden;

}


.video-news-section iframe,
.video-news-section video {

    width: 100%;

    height: 100%;

    border: 0;

}


.video-news-section .card {

    transition: transform 0.2s ease,
                box-shadow 0.2s ease;

}


.video-news-section .card:hover {

    transform: translateY(-3px);

}


.video-unavailable {

    width: 100%;
    height: 100%;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #f5f5f5;

    color: #777;

}


@media (max-width: 768px) {

    .video-news-section {

        padding-top: 30px !important;
        padding-bottom: 30px !important;

    }

}

</style>