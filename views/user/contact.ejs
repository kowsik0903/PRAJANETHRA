<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>

<div class="container mt-5 mb-5">

    <h2>Contact Us</h2>

    <form action="/contact" method="POST">

        <div class="mb-3">
            <label>Name</label>
            <input
                type="text"
                name="name"
                class="form-control"
                required>
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input
                type="email"
                name="email"
                class="form-control"
                required>
        </div>

        <div class="mb-3">
            <label>Subject</label>
            <input
                type="text"
                name="subject"
                class="form-control"
                required>
        </div>

        <div class="mb-3">
            <label>Message</label>
            <textarea
                name="message"
                rows="6"
                class="form-control"
                required></textarea>
        </div>

        <button class="btn btn-danger">
            Send Message
        </button>

    </form>

</div>

<%- include("../layouts/footer") %>