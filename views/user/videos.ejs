<%- include("../layouts/header") %>

<div class="container py-5">

```
<div class="text-center mb-5">

    <h2 class="fw-bold">
        🎥 Video News
    </h2>

    <p class="text-muted">
        Latest news videos from PRAJANETHRA
    </p>

</div>


<% if (!videos || videos.length === 0) { %>

    <div class="text-center py-5">

        <h4 class="text-muted">
            No videos available.
        </h4>

    </div>

<% } else { %>

    <div class="row g-4">

        <% videos.forEach(video => { %>

            <div class="col-lg-6 col-xl-4">

                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">

                    <div class="ratio ratio-16x9">

                        <% if (video.video_type === "upload" && video.video_url) { %>

                            <!-- Uploaded Cloudinary Video -->

                            <video
                                controls
                                preload="metadata"
                                style="width: 100%; height: 100%; object-fit: cover;">

                                <source
                                    src="<%= video.video_url %>"
                                    type="video/mp4">

                                Your browser does not support the video player.

                            </video>


                        <% } else if (video.youtube_url) { %>

                            <!-- YouTube Video -->

                            <%
                                let videoId = "";
                                const youtubeUrl = video.youtube_url || "";

                                if (youtubeUrl.includes("watch?v=")) {

                                    videoId = youtubeUrl
                                        .split("watch?v=")[1]
                                        .split("&")[0];

                                } else if (youtubeUrl.includes("youtu.be/")) {

                                    videoId = youtubeUrl
                                        .split("youtu.be/")[1]
                                        .split("?")[0];

                                } else if (youtubeUrl.includes("/embed/")) {

                                    videoId = youtubeUrl
                                        .split("/embed/")[1]
                                        .split("?")[0];

                                }
                            %>


                            <% if (videoId) { %>

                                <iframe
                                    src="https://www.youtube.com/embed/<%= videoId %>"
                                    title="<%= video.title %>"
                                    frameborder="0"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen>
                                </iframe>

                            <% } else { %>

                                <div class="d-flex align-items-center justify-content-center bg-light h-100">

                                    <span class="text-muted">
                                        Video unavailable
                                    </span>

                                </div>

                            <% } %>


                        <% } else { %>

                            <!-- No valid video URL -->

                            <div class="d-flex align-items-center justify-content-center bg-light h-100">

                                <span class="text-muted">
                                    Video unavailable
                                </span>

                            </div>

                        <% } %>

                    </div>


                    <div class="card-body">

                        <h5 class="card-title fw-bold">
                            <%= video.title %>
                        </h5>


                        <% if (video.category_name) { %>

                            <span class="badge bg-danger mb-2">

                                <%= video.category_name %>

                            </span>

                        <% } %>


                        <% if (video.description) { %>

                            <p class="card-text text-muted">

                                <%= video.description %>

                            </p>

                        <% } %>


                        <small class="text-muted d-block mb-3">

                            <%= new Date(video.created_at).toLocaleDateString() %>

                        </small>


                        <!-- Share Button -->

                        <button
                            type="button"
                            class="btn btn-outline-primary btn-sm share-video-btn"
                            data-video-id="<%= video.id %>"
                            data-video-title="<%= video.title %>">

                            <i class="bi bi-share"></i>
                            Share

                        </button>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

<% } %>
```

</div>

<script>

document.addEventListener("DOMContentLoaded", function () {

    const shareButtons =
        document.querySelectorAll(".share-video-btn");


    shareButtons.forEach(function (button) {

        button.addEventListener("click", async function () {

            const videoId = this.dataset.videoId;
            const title = this.dataset.videoTitle;


            const url =
                window.location.origin +
                "/video/" +
                videoId;


            if (navigator.share) {

                try {

                    await navigator.share({
                        title: title,
                        text: title,
                        url: url
                    });

                } catch (error) {

                    console.log("Share cancelled");

                }

            } else {

                try {

                    await navigator.clipboard.writeText(url);

                    alert("Video link copied!");

                } catch (error) {

                    alert("Unable to copy video link.");

                }

            }

        });

    });

});

</script>

