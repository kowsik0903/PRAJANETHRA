<%- include("../layouts/header") %>

<%- include("../layouts/navbar") %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <article class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-body p-4 p-md-5">

                    <!-- CATEGORY -->

                    <span class="badge bg-danger mb-3">

                        🎥 <%= video.category_name || "Video News" %>

                    </span>


                    <!-- TITLE -->

                    <h1 class="fw-bold mb-3 video-detail-title">

                        <%= video.title %>

                    </h1>


                    <!-- SHORT DESCRIPTION -->

                    <% if (video.short_description) { %>

                        <div class="video-short-description">

                            <%= video.short_description %>

                        </div>

                    <% } %>


                    <!-- VIDEO -->

                    <div class="video-detail-wrapper my-4">

                        <% if (video.video_type === "upload" && video.video_url) { %>

                           <video
    controls
    controlsList="nodownload noplaybackrate"
    disablePictureInPicture
    oncontextmenu="return false;"
    preload="metadata"
    style="width: 100%; height: auto;">

    <source
        src="<%= video.video_url %>"
        type="video/mp4">

    Your browser does not support the video player.

</video>


                        <% } else if (video.youtube_url) { %>

                            <%
                                let videoId = "";
                                const youtubeUrl = video.youtube_url || "";

                                if (youtubeUrl.includes("watch?v=")) {

                                    videoId = youtubeUrl
                                        .split("watch?v=")[1]
                                        .split("&")[0];

                                } else if (youtubeUrl.includes("youtu.be/")) {

                                    videoId = youtubeUrl
                                        .split("youtu.be/")[1]
                                        .split("?")[0];

                                } else if (youtubeUrl.includes("/embed/")) {

                                    videoId = youtubeUrl
                                        .split("/embed/")[1]
                                        .split("?")[0];

                                }
                            %>


                            <% if (videoId) { %>

                                <iframe
                                    src="https://www.youtube.com/embed/<%= videoId %>"
                                    title="<%= video.title %>"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    allowfullscreen>
                                </iframe>

                            <% } else { %>

                                <div class="video-unavailable">
                                    Video unavailable
                                </div>

                            <% } %>


                        <% } else { %>

                            <div class="video-unavailable">
                                Video unavailable
                            </div>

                        <% } %>

                    </div>


                    <!-- FULL NEWS CONTENT -->

                    <% if (video.content) { %>

                        <div class="video-content">

                            <%= video.content %>

                        </div>

                    <% } %>


                    <!-- SHARE -->

                    <div class="mt-4 pt-3 border-top">

                        <button
                            type="button"
                            class="btn btn-outline-primary"
                            onclick="shareVideo()">

                            <i class="bi bi-share"></i>

                            Share Video

                        </button>

                    </div>

                </div>

            </article>

        </div>

    </div>

</div>


<style>

.video-detail-title {

    font-size: 38px;

    line-height: 1.3;

}


.video-short-description {

    font-size: 19px;

    line-height: 1.7;

    color: #555;

    padding-bottom: 10px;

}


.video-detail-wrapper {

    width: 100%;

    max-width: 850px;

    margin-left: auto;

    margin-right: auto;

    aspect-ratio: 16 / 9;

}


.video-detail-wrapper iframe,
.video-detail-wrapper video {

    width: 100%;

    height: 100%;

    border: 0;

    border-radius: 12px;

    object-fit: cover;

}


.video-content {

    font-size: 18px;

    line-height: 2;

    color: #222;

    white-space: pre-line;

    margin-top: 25px;

}


.video-unavailable {

    width: 100%;

    height: 100%;

    display: flex;

    align-items: center;

    justify-content: center;

    background: #f5f5f5;

    color: #777;

    border-radius: 12px;

}


@media (max-width: 768px) {

    .video-detail-title {

        font-size: 28px;

    }


    .video-short-description {

        font-size: 16px;

    }


    .video-content {

        font-size: 16px;

        line-height: 1.8;

    }

}

</style>


<script>

async function shareVideo() {

    const url = window.location.href;

    const title =
        document
            .querySelector(".video-detail-title")
            .textContent
            .trim();

    const descriptionElement =
        document.querySelector(".video-short-description");

    const description =
        descriptionElement
            ? descriptionElement.textContent.trim()
            : "";


    const shareText =
        description
            ? title + "\n\n" + description
            : title;


    if (navigator.share) {

        try {

            await navigator.share({

                title: title,

                text: shareText,

                url: url

            });

        } catch (error) {

            console.log("Share cancelled");

        }

    } else {

        try {

            await navigator.clipboard.writeText(

                shareText +
                "\n\n" +
                url

            );

            alert("Video link copied!");

        } catch (error) {

            alert("Unable to copy video link.");

        }

    }

}

</script>


<%- include("../layouts/footer") %>