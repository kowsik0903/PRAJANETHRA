<!DOCTYPE html>

<html lang="en">

<head>

```
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<%
    const isVideo =
        typeof item !== "undefined" &&
        typeof item.video_type !== "undefined";

    let metaTitle =
        typeof item !== "undefined"
            ? item.title
            : "PRAJANEATHRA";

    let metaDescription =
        typeof item !== "undefined" && item.description
            ? item.description
            : "Latest Telugu News from PRAJANEATHRA";

    let metaUrl =
        "https://prajanethra.onrender.com";

    let metaImage =
        "https://prajanethra.onrender.com/logo.png";


    if (isVideo) {

        metaUrl =
            "https://prajanethra.onrender.com/video/" +
            item.id;


        /*
         * YouTube thumbnail
         */

        if (item.youtube_url) {

            let youtubeId = "";

            if (item.youtube_url.includes("watch?v=")) {

                youtubeId =
                    item.youtube_url
                        .split("watch?v=")[1]
                        .split("&")[0];

            } else if (item.youtube_url.includes("youtu.be/")) {

                youtubeId =
                    item.youtube_url
                        .split("youtu.be/")[1]
                        .split("?")[0];

            } else if (item.youtube_url.includes("/embed/")) {

                youtubeId =
                    item.youtube_url
                        .split("/embed/")[1]
                        .split("?")[0];

            }


            if (youtubeId) {

                metaImage =
                    "https://img.youtube.com/vi/" +
                    youtubeId +
                    "/hqdefault.jpg";

            }

        }


        /*
         * Cloudinary uploaded video thumbnail
         */

        else if (item.video_url) {

            metaImage =
                item.video_url
                    .replace(
                        "/video/upload/",
                        "/video/upload/so_0/"
                    )
                    .replace(/\.(mp4|webm|mov)$/i, ".jpg");

        }

    } else if (typeof item !== "undefined") {

        /*
         * News article
         */

        metaUrl =
            "https://prajanethra.onrender.com/news/" +
            item.id;


        if (item.image) {

            metaImage = item.image;

        }

    }

%>


<title>
    <%= metaTitle %>
</title>


<!-- Open Graph -->

<meta property="og:title"
      content="<%= metaTitle %>">

<meta property="og:description"
      content="<%= metaDescription %>">

<meta property="og:image"
      content="<%= metaImage %>">

<meta property="og:image:secure_url"
      content="<%= metaImage %>">

<meta property="og:image:type"
      content="image/jpeg">

<meta property="og:image:width"
      content="1200">

<meta property="og:image:height"
      content="630">

<meta property="og:url"
      content="<%= metaUrl %>">

<meta property="og:type"
      content="<%= isVideo ? 'video.other' : 'article' %>">

<meta property="og:site_name"
      content="PRAJANEATHRA">


<!-- Twitter -->

<meta name="twitter:card"
      content="summary_large_image">

<meta name="twitter:title"
      content="<%= metaTitle %>">

<meta name="twitter:description"
      content="<%= metaDescription %>">

<meta name="twitter:image"
      content="<%= metaImage %>">


<link rel="stylesheet" href="/css/style.css">

<link rel="stylesheet" href="/css/responsive.css">

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet">

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
```

</head>
