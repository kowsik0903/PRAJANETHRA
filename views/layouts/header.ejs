<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<%
    let metaTitle = "PRAJANETHRA";

    let metaDescription =
        "Latest Telugu News from PRAJANETHRA";

    let metaUrl =
        "https://prajanethra.onrender.com";

    let metaImage =
    "https://prajanethra.onrender.com/logo.png";

    let metaType = "article";

    /*
     * ==========================================
     * VIDEO PAGE
     * ==========================================
     */

    if (typeof video !== "undefined" && video) {

        metaType = "video.other";

    metaTitle =
        "🎥 VIDEO NEWS | " +
        (video.title || "PRAJANETHRA")

        metaDescription =
            video.short_description ||
            video.description ||
            video.content ||
            "Latest video news from PRAJANETHRA";

        metaUrl =
            "https://prajanethra.onrender.com/videos/" +
            video.id;


        /*
         * ======================================
         * YOUTUBE VIDEO
         * ======================================
         */

        if (video.youtube_url && video.youtube_url.trim() !== "") {

    const youtubeUrl = video.youtube_url.trim();

    let youtubeId = "";

    if (youtubeUrl.includes("watch?v=")) {

        youtubeId = youtubeUrl
            .split("watch?v=")[1]
            .split("&")[0];

    } else if (youtubeUrl.includes("youtu.be/")) {

        youtubeId = youtubeUrl
            .split("youtu.be/")[1]
            .split("?")[0]
            .split("&")[0];

    } else if (youtubeUrl.includes("/embed/")) {

        youtubeId = youtubeUrl
            .split("/embed/")[1]
            .split("?")[0]
            .split("&")[0];

    } else if (youtubeUrl.includes("/shorts/")) {

        youtubeId = youtubeUrl
            .split("/shorts/")[1]
            .split("?")[0]
            .split("&")[0];

    }

   if (youtubeId) {

        metaImage =
            "https://img.youtube.com/vi/" +
            youtubeId +
            "/hqdefault.jpg";

    }
}


        /*
         * ======================================
         * CLOUDINARY UPLOADED VIDEO
         * ======================================
         */

        else if (
            video.video_url &&
            video.video_url.trim() !== ""
        ) {

            let cloudinaryVideo =
                video.video_url.trim();


            metaImage =
                cloudinaryVideo
                    .replace(
                        "/video/upload/",
                        "/video/upload/so_0,w_1200,h_630,c_fill/"
                    )
                    .replace(
                        /\.(mp4|webm|mov|mkv|3gp|avi|mpeg|mpg)$/i,
                        ".jpg"
                    );

        }

    }


    /*
     * ==========================================
     * NORMAL NEWS ARTICLE
     * ==========================================
     */

    else if (
        typeof item !== "undefined" &&
        item
    ) {

        metaTitle =
            item.title || "PRAJANETHRA";

        metaDescription =
            item.short_description ||
            item.description ||
            item.content ||
            "Latest Telugu News from PRAJANETHRA";

        metaUrl =
            "https://prajanethra.onrender.com/news/" +
            item.id;


        if (
            item.image &&
            item.image.trim() !== ""
        ) {

            metaImage =
                item.image;

        }

    }
%>

<title>
    <%= metaTitle %>
</title>


<!-- ========================================== -->
<!-- BASIC DESCRIPTION -->
<!-- ========================================== -->

<meta
    name="description"
    content="<%= metaDescription %>"
>


<!-- ========================================== -->
<!-- OPEN GRAPH -->
<!-- ========================================== -->

<meta
    property="og:title"
    content="<%= metaTitle %>"
>

<meta
    property="og:description"
    content="<%= metaDescription %>"
>

<meta
    property="og:image"
    content="<%= metaImage %>"
>
<meta
    property="og:image:secure_url"
    content="<%= metaImage %>"
>

<meta
    property="og:image:type"
    content="image/jpeg"
>

<meta
    property="og:image:width"
    content="1200"
>

<meta
    property="og:image:height"
    content="630"
>

<meta
    property="og:url"
    content="<%= metaUrl %>"
>

<meta
    property="og:type"
    content="<%= metaType %>"
>

<meta
    property="og:site_name"
    content="PRAJANETHRA"
>


<!-- ========================================== -->
<!-- TWITTER / X -->
<!-- ========================================== -->

<meta
    name="twitter:card"
    content="summary_large_image"
>

<meta
    name="twitter:title"
    content="<%= metaTitle %>"
>

<meta
    name="twitter:description"
    content="<%= metaDescription %>"
>

<meta
    name="twitter:image"
    content="<%= metaImage %>"
>


<!-- ========================================== -->
<!-- CSS -->
<!-- ========================================== -->

<link
    rel="stylesheet"
    href="/css/style.css"
>

<link
    rel="stylesheet"
    href="/css/responsive.css"
>

<link
    rel="stylesheet"
    href="/css/video-news.css"
>


<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>


<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>


</head>