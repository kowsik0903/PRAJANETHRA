<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
<%= typeof item !== "undefined" ? item.title : "NC NEWS" %>
</title>

<meta property="og:title"
      content="<%= typeof item !== 'undefined' ? item.title : 'NC NEWS' %>">

<meta property="og:description"
      content="<%= typeof item !== 'undefined' ? item.description : 'Latest Telugu News' %>">

<meta property="og:image"
      content="<%= typeof item !== 'undefined' ? item.image : 'https://your-domain.com/logo.png' %>">

<meta property="og:url"
      content="<%= typeof item !== 'undefined'
      ? ('https://ncnews-qhvk.onrender.com/news/' + item.id)
      : 'https://ncnews-qhvk.onrender.com' %>">

<meta property="og:type" content="article">

<meta property="og:site_name" content="NC NEWS">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title"
      content="<%= typeof item !== 'undefined' ? item.title : 'NC NEWS' %>">

<meta name="twitter:description"
      content="<%= typeof item !== 'undefined' ? item.description : 'Latest Telugu News' %>">

<meta name="twitter:image"
      content="<%= typeof item !== 'undefined' ? item.image : 'https://your-domain.com/logo.png' %>">

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/responsive.css">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>