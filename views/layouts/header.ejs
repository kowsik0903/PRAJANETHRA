<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<%

    /*
     * ==========================================
     * DEFAULT META VALUES
     * ==========================================
     */

    let metaTitle = "PRAJANEATHRA";

    let metaDescription =
        "Latest Telugu News from PRAJANEATHRA";

    let metaUrl =
        "https://prajanethra.onrender.com";

    let metaImage =
        "https://prajanethra.onrender.com/logo.png";

    let isVideo = false;


    /*
     * ==========================================
     * VIDEO PAGE
     * ==========================================
     *
     * video-details controller sends:
     *
     * video
     * categories
     * item: video
     *
     */

    if (
        typeof video !== "undefined" &&
        video
    ) {

        isVideo = true;

        metaTitle =
            video.title || "PRAJANETHRA";


        /*
         * IMPORTANT:
         * Use short_description
         */

        metaDescription =
            video.short_description ||
            video.content ||
            "Latest video news from PRAJANETHRA";


        /*
         * IMPORTANT:
         * Your actual route is:
         *
         * /videos/:id
         */

        metaUrl =
            "https://prajanethra.onrender.com/videos/" +
            video.id;


        /*
         * ======================================
         * YOUTUBE THUMBNAIL
         * ======================================
         */

        if (
            video.youtube_url &&
            video.youtube_url.trim() !== ""
        ) {

            let youtubeId = "";

            const youtubeUrl =
                video.youtube_url.trim();


            if (
                youtubeUrl.includes("watch?v=")
            ) {

                youtubeId =
                    youtubeUrl
                        .split("watch?v=")[1]
                        .split("&")[0];

            }

            else if (
                youtubeUrl.includes("youtu.be/")
            ) {

                youtubeId =
                    youtubeUrl
                        .split("youtu.be/")[1]
                        .split("?")[0];

            }

            else if (
                youtubeUrl.includes("/embed/")
            ) {

                youtubeId =
                    youtubeUrl
                        .split("/embed/")[1]
                        .split("?")[0];

            }


            if (youtubeId) {

                metaImage =
                    "https://img.youtube.com/vi/" +
                    youtubeId +
                    "/maxresdefault.jpg";

            }

        }


        /*
         * ======================================
         * CLOUDINARY VIDEO THUMBNAIL
         * ======================================
         */

        else if (
            video.video_url &&
            video.video_url.trim() !== ""
        ) {

            metaImage =
                video.video_url
                    .replace(
                        "/video/upload/",
                        "/video/upload/so_0/"
                    )
                    .replace(
                        /\.(mp4|webm|mov)$/i,
                        ".jpg"
                    );

        }

    }


    /*
     * ==========================================
     * NORMAL NEWS ARTICLE
     * ==========================================
     */

    else if (
        typeof item !== "undefined" &&
        item
    ) {

        metaTitle =
            item.title || "PRAJANETHRA";


        metaDescription =
            item.short_description ||
            item.description ||
            item.content ||
            "Latest Telugu News from PRAJANETHRA";


        metaUrl =
            "https://prajanethra.onrender.com/news/" +
            item.id;


        if (
            item.image &&
            item.image.trim() !== ""
        ) {

            metaImage = item.image;

        }

    }

%>


<title>
    <%= metaTitle %>
</title>


<!-- ========================================== -->
<!-- BASIC DESCRIPTION -->
<!-- ========================================== -->

<meta
    name="description"
    content="<%= metaDescription %>"
>


<!-- ========================================== -->
<!-- OPEN GRAPH -->
<!-- ========================================== -->

<meta
    property="og:title"
    content="<%= metaTitle %>"
>

<meta
    property="og:description"
    content="<%= metaDescription %>"
>

<meta
    property="og:image"
    content="<%= metaImage %>"
>

<meta
    property="og:image:secure_url"
    content="<%= metaImage %>"
>

<meta
    property="og:image:type"
    content="image/jpeg"
>

<meta
    property="og:image:width"
    content="1200"
>

<meta
    property="og:image:height"
    content="630"
>

<meta
    property="og:url"
    content="<%= metaUrl %>"
>

<meta
    property="og:type"
    content="<%= isVideo ? 'video.other' : 'article' %>"
>

<meta
    property="og:site_name"
    content="PRAJANETHRA"
>


<!-- ========================================== -->
<!-- TWITTER / X -->
<!-- ========================================== -->

<meta
    name="twitter:card"
    content="summary_large_image"
>

<meta
    name="twitter:title"
    content="<%= metaTitle %>"
>

<meta
    name="twitter:description"
    content="<%= metaDescription %>"
>

<meta
    name="twitter:image"
    content="<%= metaImage %>"
>


<!-- ========================================== -->
<!-- CSS -->
<!-- ========================================== -->

<link
    rel="stylesheet"
    href="/css/style.css"
>

<link
    rel="stylesheet"
    href="/css/responsive.css"
>

<link
    rel="stylesheet"
    href="/css/video-news.css"
>


<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
>


<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
>


</head>